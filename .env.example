# ==========================================================================
# Secretos de Donna Botánica / Terra Macetas
# Copiar a /opt/terra-macetas/.env en el servidor y completar.
# Este archivo de ejemplo NO lleva valores reales. El .env real nunca va a git.
#
# Generar valores seguros con:   openssl rand -hex 32
# Usar solo letras, números, guion y guion bajo: los valores van dentro de
# cadenas de conexión, donde ; @ : / rompen el formato.
# ==========================================================================

# SQL Server (usuario sa). Mínimo 8 caracteres con mayúsculas, minúsculas y números.
TERRA_SQL_SA_PASSWORD=

# Postgres de Evolution API
TERRA_EVOLUTION_DB_PASSWORD=

# Clave global de Evolution API (la usa la API para mandar WhatsApp)
TERRA_EVOLUTION_API_KEY=

# Firma de los tokens de login del panel /admin (mínimo 32 caracteres)
TERRA_JWT_KEY_PROD=
TERRA_JWT_KEY_TEST=

# Token del webhook de WhatsApp. En Evolution la URL queda:
#   https://donnabotanica.com.py/api/whatsapp/webhook?token=<TERRA_WEBHOOK_TOKEN_PROD>
TERRA_WEBHOOK_TOKEN_PROD=
TERRA_WEBHOOK_TOKEN_TEST=
